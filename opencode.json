  "mcp": {
    "searxng": {
      "type": "remote",
      "url": "http://127.0.0.1:8101/mcp",
      "enabled": true
    },
    "websearch": {
      "type": "remote",
      "url": "http://127.0.0.1:8102/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "http://127.0.0.1:8103/mcp",
      "enabled": true
    },
    "git": {
      "type": "remote",
      "url": "http://127.0.0.1:8104/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "remote",
      "url": "http://127.0.0.1:8105/mcp",
      "enabled": true
    },
    "filesystem": {
      "type": "remote",
      "url": "http://127.0.0.1:8106/mcp",
      "enabled": true
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "task": "allow",
    "searxng_*": "allow",
    "websearch_*": "allow",
    "github_*": "allow",
    "git_*": "allow",
    "playwright_*": "allow",
    "filesystem_*": "allow",
    "bash": {
      "*": "deny",
      "ollama show *": "allow",
      "ollama ps": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "python3 agent-rules/scripts/validate_run_config.py*": "allow",
      "python3 -m unittest discover -s agent-rules/tests*": "allow"
    },
    "external_directory": "deny"
  }
}
