{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3:235b",
  "default_agent": "catalog-coordinator",
  "enabled_providers": [
    "ollama"
  ],
  "instructions": [
    "agent-rules/rules/*.md"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "On-premises Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3:235b": {
          "name": "qwen3:235b",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "deepseek-r1:70b-llama-distill-q8_0": {
          "name": "deepseek-r1:70b-llama-distill-q8_0",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3-coder-next:q8_0": {
          "name": "qwen3-coder-next:q8_0",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "laguna-s-2.1:q4_K_M": {
          "name": "laguna-s-2.1:q4_K_M",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.8:27b": {
          "name": "qwen3.8:27b",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.5:122b": {
          "name": "qwen3.5:122b",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "translategemma:27b": {
          "name": "translategemma:27b",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "huihui_ai/qwen3-abliterated:235b-a22b-Q3_K_M": {
          "name": "huihui_ai/qwen3-abliterated:235b-a22b-Q3_K_M",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "hf.co/ThalisAI/DeepSeek-R1-Distill-Llama-70B-heretic:Q8_0": {
          "name": "hf.co/ThalisAI/DeepSeek-R1-Distill-Llama-70B-heretic:Q8_0",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3-coder-next:q4_K_M": {
          "name": "qwen3-coder-next:q4_K_M",
